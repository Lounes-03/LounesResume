    // Day Selection logic script
document.querySelectorAll('.day-number:not(.empty)').forEach(item => {
    item.addEventListener('click', function() {
        document.querySelectorAll('.day-number').forEach(d => d.classList.remove('selected'));
        this.classList.add('selected');
        document.getElementById('input_date').value = this.getAttribute('data-date');
    });
});

// ADD THIS: Automatically set today's date into the hidden input on page load
const todayElement = document.querySelector('.day-number.today');
if (todayElement) {
    todayElement.classList.add('selected'); // Make it look selected visually
    document.getElementById('input_date').value = todayElement.getAttribute('data-date'); // Set value
}

// Time Selection logic script
document.querySelectorAll('.time-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
        this.classList.add('selected');
        document.getElementById('input_time').value = this.getAttribute('data-time');
    });
});

// Validation protection rule checking for selections before allowing dispatch
document.getElementById('appointmentForm').addEventListener('submit', function(e) {
    const dVal = document.getElementById('input_date').value;
    const tVal = document.getElementById('input_time').value;
    if(!dVal || !tVal) {
        e.preventDefault();
        alert('Please select both a day and a time slot first!');
    }
});
