<script>

document.addEventListener("DOMContentLoaded", function () {

    // ==============================
    // DATE SELECTION
    // ==============================

    const dayNumbers = document.querySelectorAll(".day-number");
    const selectedDate = document.getElementById("selected_date");

    dayNumbers.forEach(function (day) {

        day.addEventListener("click", function () {

            selectedDate.value = this.dataset.date;

            dayNumbers.forEach(function (d) {
                d.classList.remove("selected");
            });

            this.classList.add("selected");

            console.log("Selected date:", selectedDate.value);
        });

    });


    // ==============================
    // TIME SELECTION
    // ==============================

    const timeButtons = document.querySelectorAll(".time-btn");
    const selectedTime = document.getElementById("selected_time");

    timeButtons.forEach(function (button) {

        button.addEventListener("click", function () {

            selectedTime.value = this.dataset.time;

            timeButtons.forEach(function (btn) {
                btn.classList.remove("selected");
            });

            this.classList.add("selected");

            console.log("Selected time:", selectedTime.value);
        });

    });


    // ==============================
    // FORM SUBMISSION
    // ==============================

    const form = document.getElementById("appointmentForm");

    form.addEventListener("submit", async function (event) {

        // IMPORTANT: prevent normal Formspree redirect
        event.preventDefault();

        console.log("Submit button clicked");

        // Check date
        if (!selectedDate.value) {
            alert("Please select a date ❤️");
            return;
        }

        // Check time
        if (!selectedTime.value) {
            alert("Please select a time ❤️");
            return;
        }

        const submitButton =
            form.querySelector(".submit-date-btn");

        submitButton.disabled = true;
        submitButton.textContent = "Setting the date ❤️";


        try {

            const response = await fetch(
                form.action,
                {
                    method: "POST",
                    body: new FormData(form),
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );


            console.log("Formspree response:", response.status);


            if (response.ok) {

                console.log("Successfully submitted!");

                // Go to next page
                window.location.href = "next.html";

            } else {

                console.error(
                    "Formspree error:",
                    response.status
                );

                submitButton.disabled = false;
                submitButton.textContent = "Set the date ❤️";

                alert(
                    "Something went wrong while sending the date."
                );
            }


        } catch (error) {

            console.error(
                "Submission error:",
                error
            );

            submitButton.disabled = false;
            submitButton.textContent = "Set the date ❤️";

            alert(
                "Could not send the date. Please try again."
            );

        }

    });

});

</script>
